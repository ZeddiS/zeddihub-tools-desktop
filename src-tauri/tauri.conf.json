{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZeddiHub Tools",
  "version": "2.0.0-1",
  "identifier": "eu.zeddihub.tools",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "ZeddiHub Tools",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "fullscreen": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "publisher": "ZeddiHub",
    "category": "DeveloperTool",
    "shortDescription": "Desktop nástroje pro CS2/CS:GO/Rust adminy."
  }
}

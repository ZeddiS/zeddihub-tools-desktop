# =========================================================================
# ZeddiHub Tools Desktop — .gitignore (po reorganizaci na Tauri root)
# =========================================================================

# --- Tauri build outputs ---
src-tauri/target/
src-tauri/gen/

# --- SvelteKit / Vite ---
.svelte-kit/
build/
.vite/
node_modules/

# --- Legacy Python build outputs ---
legacy/dist/
legacy/build/
legacy/__pycache__/
legacy/**/__pycache__/
legacy/**/*.pyc
legacy/**/*.exe
legacy/**/*.spec
legacy/modules/**/dist/
!legacy/ZeddiHubTools.spec

# --- PoC build outputs (artefakty na GitHub release, ne v gitu) ---
poc/**/dist/
poc/**/*.exe
poc/**/*.msi
poc/**/*.spec
poc/**/build/

# --- Stará v2 podsložka (residual, file lock; smazat manuálně) ---
zeddihub_v2/

# --- IDE/editor ---
.vscode/
.idea/
*.log

# --- Runtime data (uzivatelska) ---
/data/
*.enc
Thumbs.db

# --- Claude / agent worktrees ---
.claude/

# --- Assets stazene z CDN za behu (negenerujeme je do repa) ---
assets/banner.png
assets/logo.png
assets/web_favicon.ico

# --- Serverova cast (od v1.7.4 v samostatnem repu zeddihub-tools-website) ---
webhosting/

# --- Google Apps Script (neni app source) ---
ZeddiHub App/

# --- Obsoletni/pracovni soubory ---
backlog_export_*.csv
RELEASE_NOTES_v*.md
release_notes_v*.md
release_1_8_0.*
security_cleanup.bat
release_1_8_0_manual.cmd
CLAUDE_OLD.md

# =========================================================================
# Secrets
# =========================================================================
.env
.env.local
*.token
.gh_token

# ZeddiHub Builder
_launch_builder.bat
.zeddibuild.local.json
_build_tmp.spec

# DS_Store / system
.DS_Store
